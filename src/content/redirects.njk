---
# One stub page per entry in src/_data/redirects.json. GitHub Pages cannot send HTTP redirects,
# so each old URL gets a small page that forwards the browser (meta refresh, with a JavaScript
# fallback and a visible link) and names the new URL as canonical for search engines.
# To keep an old deep link working after you rename or remove a page, add an entry to
# redirects.json. Do not delete entries: someone may still have the old link.
pagination:
  data: redirects
  size: 1
  alias: r
permalink: "{{ r.from }}index.html"
eleventyExcludeFromCollections: true
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Page moved</title>
<meta name="robots" content="noindex">
<link rel="canonical" href="{{ r.to }}">
<meta http-equiv="refresh" content="0; url={{ r.to }}">
<script>location.replace({{ (r.to | url) | dump | safe }} + location.search + location.hash);</script>
</head>
<body>
<p>This page moved to <a href="{{ r.to }}">{{ r.to }}</a>.</p>
</body>
</html>
